{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.core.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],

    /* core/ is host-agnostic: no DOM, no Node. A stray `window`, `process` or
       `fetch` in here is a compile error rather than a crash in one of the
       two hosts. */
    "types": [],
    "skipLibCheck": true,

    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["core/*.ts"],
  "exclude": ["core/*.test.ts", "core/test-support.ts"]
}
