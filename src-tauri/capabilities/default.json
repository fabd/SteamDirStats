{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app window may call. The filesystem commands carry no scope of their own: the folders are allowed at runtime by allow_steam_folder and data_dir once the scan has found them (plan.md 7d), so an allowed command still reads nothing until then. The opener may only hand out steam:// URLs; opening a folder goes through the open_folder command, which checks that same runtime scope.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-unmaximize",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-center",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-outer-position",
    "core:window:allow-inner-size",
    "core:window:allow-is-maximized",
    "core:window:allow-available-monitors",
    "core:window:allow-scale-factor",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-write-text-file",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.steampowered.com/*" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "steam://*" }]
    }
  ]
}
